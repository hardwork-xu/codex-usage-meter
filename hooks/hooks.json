{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/scripts/meter.py\" hook",
            "async": true,
            "timeout": 10,
            "commandWindows": "py -3 -X utf8 (Join-Path -Path $env:PLUGIN_ROOT -ChildPath 'scripts/meter.py') hook; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/scripts/meter.py\" hook",
            "async": true,
            "timeout": 10,
            "commandWindows": "py -3 -X utf8 (Join-Path -Path $env:PLUGIN_ROOT -ChildPath 'scripts/meter.py') hook; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/scripts/meter.py\" hook",
            "async": true,
            "timeout": 10,
            "commandWindows": "py -3 -X utf8 (Join-Path -Path $env:PLUGIN_ROOT -ChildPath 'scripts/meter.py') hook; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/scripts/meter.py\" hook",
            "async": true,
            "timeout": 10,
            "commandWindows": "py -3 -X utf8 (Join-Path -Path $env:PLUGIN_ROOT -ChildPath 'scripts/meter.py') hook; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/scripts/meter.py\" hook",
            "async": true,
            "timeout": 3,
            "commandWindows": "py -3 -X utf8 (Join-Path -Path $env:PLUGIN_ROOT -ChildPath 'scripts/meter.py') hook; exit $LASTEXITCODE"
          }
        ]
      }
    ]
  }
}
